# Copy to .env and fill in only what you need. Never commit .env.
# Optional LLM judge for claim support (leave empty to disable).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAlex polite-pool contact (recommended).
CITEGUARD_MAILTO=
# Cap the number of references checked by the claim-support judge.
CITEGUARD_SUPPORT_MAX_REFS=12
