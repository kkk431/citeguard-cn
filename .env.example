# Copy to .env and fill in only what you need. Never commit .env.
# Optional LLM judge for claim support (leave empty to disable).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAlex polite-pool contact (recommended).
CITEGUARD_MAILTO=
# Cap the number of references checked by the claim-support judge.
CITEGUARD_SUPPORT_MAX_REFS=12
# Web-citation ([EB/OL]) link check: reachable page + matching <title> => verified.
# Set to 0 for fully offline deployments (no outbound link requests).
CITEGUARD_URL_CHECK=1
CITEGUARD_URL_CHECK_TIMEOUT=8
# Optional: point the claim-support judge at any OpenAI-compatible server
# (e.g. Ollama http://127.0.0.1:11434/v1) to judge with a local open model.
CITEGUARD_JUDGE_BASE_URL=
CITEGUARD_JUDGE_MODEL=
CITEGUARD_JUDGE_API_KEY=
# Small local models follow the shorter prompt better than the built-in long
# one (see docs/support_summary.md); custom prompts get their own cache namespace.
# CITEGUARD_SUPPORT_PROMPT_FILE=scripts/support_prompt_simple.txt
# Two-stage coverage audit (default on); disable it for small local judges if
# their verdicts become too conservative.
CITEGUARD_SUPPORT_AUDIT=1
