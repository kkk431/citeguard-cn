# Copy to .env and fill in only what you need. Never commit .env.
# Optional LLM judge for claim support (leave empty to disable).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# OpenAlex polite-pool contact (recommended).
CITEGUARD_MAILTO=
# Cap the number of references checked by the claim-support judge.
CITEGUARD_SUPPORT_MAX_REFS=12
# Web-citation ([EB/OL]) link check: reachable page + matching <title> => verified.
# Set to 0 for fully offline deployments (no outbound link requests).
CITEGUARD_URL_CHECK=1
CITEGUARD_URL_CHECK_TIMEOUT=8
# Optional: point the claim-support judge at any OpenAI-compatible server
# (e.g. Ollama http://127.0.0.1:11434/v1) to judge with a local open model.
CITEGUARD_JUDGE_BASE_URL=
CITEGUARD_JUDGE_MODEL=
CITEGUARD_JUDGE_API_KEY=
# Small local models follow the shorter prompt better than the built-in long
# one (see docs/support_summary.md); custom prompts get their own cache namespace.
# Both hosted and self-hosted judges default to the measured v10 few-shot prompt;
# set this to override (e.g. support_prompt_simple.txt for <=3B models).
# CITEGUARD_SUPPORT_PROMPT_FILE=scripts/support_prompt_simple.txt
# Two-stage coverage audit (default on); disable it for small local judges if
# their verdicts become too conservative. Style: auto = v1 for hosted APIs,
# v2 for self-hosted endpoints (measured better on Qwen3-8B/14B).
CITEGUARD_SUPPORT_AUDIT=1
# CITEGUARD_SUPPORT_AUDIT_STYLE=auto   # v1 | v2 | auto

# Optional figure-claim check: point at an OpenAI-compatible vision server
# (scripts/local_vl_server.py running Qwen2.5-VL-7B on a GPU host).
# Leave empty to hide the /figure feature.
CITEGUARD_VL_ENDPOINT=
CITEGUARD_VL_MODEL=qwen2.5-vl-7b
CITEGUARD_VL_API_KEY=
CITEGUARD_VL_TIMEOUT=60
CITEGUARD_VL_MAX_FIGURE_MB=8

# --- Public demo hardening (optional) ---
# Require a token for every page/API request. Open a page with ?token=... once;
# an HttpOnly cookie keeps the browser session working. API clients may send
# X-Access-Token or Authorization: Bearer <token> instead.
CITEGUARD_ACCESS_TOKEN=
# Per-IP limit for POST /api/* per minute (0 disables). GET routes are unlimited.
CITEGUARD_RATE_LIMIT_PER_MIN=120
# Parallel claim-support judge calls (clamped to 1..8).
CITEGUARD_SUPPORT_WORKERS=4

# 万方开放平台（可选，中文题录兜底）。订阅「万方文献检索」后填 App Key。
# 鉴权头 X-App-Key，必须 HTTPS；免费额度 100 次/天。申请：https://ai.wfdata.com/api-detail?id=17
WANFANG_APP_KEY=

# 图表核验 prompt：2=快（默认，中文论文图表足够）；4=分步读图（慢约 2 倍，公开/复杂图表更稳）
# CITEGUARD_FIGURE_PROMPT=2
