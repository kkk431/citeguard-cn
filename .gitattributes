# Keep data and code line endings stable so dataset SHA-256 values are
# reproducible across Windows/macOS/Linux checkouts.
* text=auto eol=lf
*.jsonl text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.pptx binary
*.pdf binary
