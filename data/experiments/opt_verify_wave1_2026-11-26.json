  {
   "id": "F2",
   "severity": "medium",
   "items": [
    "B2"
   ],
   "title": "Result-cache key excludes the local library option while analysis uses it",
   "detail": "src/citeguard/pipeline.py:214 builds key_options without 'library', but the analysis consumes the library at pipeline.py:232,319,324,358-359 (local_library_verdict, library_entries, library_hits). Same file + options + versions with a changed local library can therefore return a stale report with outdated local-library verdicts. docs/optimization/b2_cache.md does not state this boundary. B2 is not wired into the web yet, so Wave1 acceptance is unaffected.",
   "evidence": [
    "src/citeguard/pipeline.py:214",
    "src/citeguard/pipeline.py:232",
    "src/citeguard/pipeline.py:319",
    "src/citeguard/pipeline.py:324",
    "src/citeguard/pipeline.py:358-359",
    "docs/optimization/b2_cache.md"
   ],
   "responsible": "B2 owner",
   "recommendation": "include a library fingerprint (size+mtime+sha of LIBRARY_FILE) in the cache key, or document that library changes require invalidate(), before wiring the cache into the web",
   "blocking": false
  },
  {
   "id": "F3",
   "severity": "info",
   "items": [
    "B2"
   ],
   "title": "hot-vs-cold speedup is not cold-start performance",
   "detail": "t32 reports 64.44x; the independent bench reproduces 67.4x (6614.1 ms -> 98.1 ms on 3 different PDFs). Cold start is still ~2.2 s/document on CPU offline, which the doc states explicitly.",
