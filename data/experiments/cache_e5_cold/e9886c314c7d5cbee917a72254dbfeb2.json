ost_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "社会科学与计算研究", "raw_type": "journal-article"}], "best_oa_location": {"id": "doi:10.55375/jssc.2024.3.6", "doi": "https://doi.org/10.55375/jssc.2024.3.6", "is_oa": true, "landing_page_url": "https://doi.org/10.55375/jssc.2024.3.6", "pdf_url": "https://qingpress.com/fs/Upload/Enclosures/b660f34e-ba59-4b0e-9c19-b6d503c38a08.pdf", "source": {"id": "https://openalex.org/S4220651941", "display_name": "社会科学与计算研究", "issn_l": "2789-553X", "issn": ["2789-553X"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": null, "host_organization_name": null, "host_organization_lineage": [], "host_organization_lineage_names": [], "type": "journal"}, "license": null, "license_id": null, "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "社会科学与计算研究", "raw_type": "journal-article"}, "sustainable_development_goals": [{"id": "https://metadata.un.org/sdg/10", "score": 0.7390999794006348, "display_name": "Reduced inequalities"}, {"id": "https://metadata.un.org/sdg/1", "score": 0.666700005531311, "display_name": "No poverty"}, {"id": "https://metadata.un.org/sdg/4", "score": 0.4156000018119812, "display_name": "Quality education"}], "sustainable_development_goals_aurora": [], "study_designs": [], "awards": [], "funders": [], "has_content": {"grobid_xml": true, "pdf": true}, "content_urls": {"pdf": "https://content.openalex.org/works/W4391040882.pdf", "grobid_xml": "https://content.openalex.org/works/W4391040882.grobid-xml"}, "referenced_works_count": 0, "referenced_works": [], "related_works": [], "abstract_inverted_index": {"在农村地区，众多农民选择进城务工，由于现实条件的限制,绝大多数外出的务工人员孩子无法同期跟随，成为留守儿童。本研究以西部某省份农村为例，通过文献研究和案例分析的方法，对农村留守儿童的教育福利政策与现状进行了研究。研究发现，由于政策法规的执行不够到位，教育条件有一定程度的缺失，留守儿童教育福利得不到有效最好的保障。本文提出，农村留守儿童教育福利的改进需要政府、学校和社会各界共同配合和参与。本文的研究为儿童福利、农村发展等相关领域的研究和实践提供了有益参考。": [0]}, "counts_by_year": [{"year": 2024, "cited_by_count": 7}], "updated_date": "2026-09-08T07:41:39.490200", "created_date": "2024-01-20T00:00:00"}