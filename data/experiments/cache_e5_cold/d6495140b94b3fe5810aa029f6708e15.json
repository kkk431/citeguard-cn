ons": [{"id": "doi:10.33142/jscs.v5i3.16935", "doi": "https://doi.org/10.33142/jscs.v5i3.16935", "is_oa": true, "landing_page_url": "https://doi.org/10.33142/jscs.v5i3.16935", "pdf_url": null, "source": {"id": "https://openalex.org/S5407033846", "display_name": "体能科学", "issn_l": "2810-9058", "issn": ["2810-9058", "2810-9066"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": "https://openalex.org/P4404660689", "host_organization_name": "Viser Technology Pte. Ltd.", "host_organization_lineage": ["https://openalex.org/P4404660689"], "host_organization_lineage_names": ["Viser Technology Pte. Ltd."], "type": "journal"}, "license": "cc-by-nc", "license_id": "https://openalex.org/licenses/cc-by-nc", "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "体能科学", "raw_type": "journal-article"}], "best_oa_location": {"id": "doi:10.33142/jscs.v5i3.16935", "doi": "https://doi.org/10.33142/jscs.v5i3.16935", "is_oa": true, "landing_page_url": "https://doi.org/10.33142/jscs.v5i3.16935", "pdf_url": null, "source": {"id": "https://openalex.org/S5407033846", "display_name": "体能科学", "issn_l": "2810-9058", "issn": ["2810-9058", "2810-9066"], "is_oa": false, "is_in_doaj": false, "is_core": false, "listed_in": [], "host_organization": "https://openalex.org/P4404660689", "host_organization_name": "Viser Technology Pte. Ltd.", "host_organization_lineage": ["https://openalex.org/P4404660689"], "host_organization_lineage_names": ["Viser Technology Pte. Ltd."], "type": "journal"}, "license": "cc-by-nc", "license_id": "https://openalex.org/licenses/cc-by-nc", "version": "publishedVersion", "is_accepted": true, "is_published": true, "raw_source_name": "体能科学", "raw_type": "journal-article"}, "sustainable_development_goals": [], "sustainable_development_goals_aurora": [], "study_designs": [], "awards": [], "funders": [], "has_content": {"pdf": false, "grobid_xml": false}, "content_urls": null, "referenced_works_count": 0, "referenced_works": [], "related_works": [], "abstract_inverted_index": {"冰雪体育旅游的高质量发展需要新质生产力。在经济新常态下，发挥新质生产力的赋能作用以助力冰雪体育旅游高质量发展，尤为重要。采用文献资料、逻辑分析等研究方法，首先从理论基础出发，阐释新质生产力、冰雪体育旅游高质量发展的相关理论概念，其次对当前我国冰雪体育旅游的发展现状进行研究分析，了解冰雪体育旅游发展中所面临的实际问题。研究发现当前我国冰雪体育旅游发展中存在资源配置不均衡、产业运营模式单一、基础设施不完善及人才短缺等问题，制约着冰雪体育旅游的发展进程。为加快新质生产力对冰雪体育旅游的赋能作用，结合我国冰雪体育旅游发展的实际，提出实践路径如下：（1）优化资源配置；（2）探索多元发展路径；（3）完善基础设施；（4）加强冰雪体育专业人才培养。": [0]}, "counts_by_year": [{"year": 2026, "cited_by_count": 4}, {"year": 2025, "cited_by_count": 10}], "updated_date": "2026-10-01T08:54:57.152042", "created_date": "2025-10-10T00:00:00"}