        "[1] 张三. 甲[J]. 期刊, 2020, 1(1): 1-2.",
        "[2] 李四. 乙[J]. 期刊, 2021, 2(2): 3-4.",
        "[3] 王五. 丙[J]. 期刊, 2022, 3(3): 5-6."
      ],
      "expected": {
        "numeric_style": true,
        "missing": [
          5
        ],
        "uncited": [
          3
        ],
        "order_inversions": 0
      }
    },
    {
      "id": "order_inversion_simple",
      "body": "先引[2]，再引[1]。",
      "refs": [
        "[1] 张三. 甲[J]. 期刊, 2020, 1(1): 1-2.",
