{
  "name": "CitationConsistency-CN",
  "description": "Body-vs-reference-list consistency cases for the GB/T 7714 sequential numeric system. Hand-built; expected outputs derive from the rule spec, not from the implementation.",
  "cases": [
    {
      "id": "all_consistent",
      "body": "方法见[1]，结果见[2]，讨论见[3]。",
      "refs": [
        "[1] 张三. 甲[J]. 期刊, 2020, 1(1): 1-2.",
        "[2] 李四. 乙[J]. 期刊, 2021, 2(2): 3-4.",
        "[3] 王五. 丙[J]. 期刊, 2022, 3(3): 5-6."
      ],
      "expected": {
        "numeric_style": true,
        "missing": [],
        "uncited": [],
        "order_inversions": 0
      }
    },
    {
      "id": "uncited_middle",
      "body": "方法见[1]，讨论见[3]。",
      "refs": [
        "[1] 张三. 甲[J]. 期刊, 2020, 1(1): 1-2.",
        "[2] 李四. 乙[J]. 期刊, 2021, 2(2): 3-4.",
        "[3] 王五. 丙[J]. 期刊, 2022, 3(3): 5-6."
      ],
      "expected": {
        "numeric_style": true,
        "missing": [],
        "uncited": [
          2
        ],
        "order_inversions": 0
      }
    },
    {
      "id": "missing_number",
      "body": "方法见[1][2]，另有[5]未在表中。",
